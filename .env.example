# AI provider. Leave AI_PROVIDER empty to use the first key that is set.
# xai | anthropic | openai
AI_PROVIDER=xai
AI_MODEL=
XAI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Image forge. Falls back to a local studio plate when neither key can draw.
# IMAGE_PROVIDER=xai|openai
IMAGE_PROVIDER=
IMAGE_MODEL=

# Solana. Use an RPC that allows browser requests if the wallet panel reads balances in the client.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_TOKEN_MINT=
NEXT_PUBLIC_TOKEN_DECIMALS=6
NEXT_PUBLIC_TOKEN_SYMBOL=SUPERAI

# Signed wallet binding. Required in production.
SESSION_SECRET=

# Postgres / Supabase. When DATABASE_URL is unset, memory is stored in .data/memory.json.
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=summons

# Optional Cloudflare R2. All five are required before uploads go there.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

NEXT_PUBLIC_APP_URL=http://localhost:3000
